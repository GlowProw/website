    { "src": "/lang-api/(.*)", "dest": "https://lang.glow-prow.top/src/data/:splat" },

    { "src": "/assets/*", "dest": "/assets/*" },
    { "src": "/static/*", "dest": "/static/*" },
    { "src": "/manifest*", "dest": "/manifest*" },
    { "src": "/*.webmanifest", "dest": "/:splat.webmanifest" },
    { "src": "/*.svg", "dest": "/:splat.svg" },
    { "src": "/*.png", "dest": "/:splat.png" },
    { "src": "/*.ico", "dest": "/:splat.ico" },
    { "src": "/*.txt", "dest": "/:splat.txt" },
    { "src": "/*.xml", "dest": "/:splat.xml" },
    { "src": "/*.json", "dest": "/:splat.json" },

    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/static/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/lang-api/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ],
  "caches": [
    { "source": "/robots.txt", "cacheTtl": 0 },
    { "source": "/sitemap.xml", "cacheTtl": 0 },
    { "source": "/ads.txt", "cacheTtl": 0 }
  ]
