{
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "status": 200
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "status": 200
    },
    {
      "src": "/ads.txt",
      "dest": "/ads.txt",
      "status": 200
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico",
      "status": 200
    },
    {
      "src": "/favicon.png",
      "dest": "/favicon.png",
      "status": 200
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ],
  "caches": [
    {
      "source": "/robots.xml",
      "cacheTtl": 0
    },
    {
      "source": "/sitemap.xml",
      "cacheTtl": 0
    },
    {
      "source": "/ads.txt",
      "cacheTtl": 0
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt",
      "statusCode": 200
    },
    {
      "source": "/robots.txt",
      "destination": "/as/robots.txt",
      "statusCode": 200
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml",
      "statusCode": 200
    },
    {
      "source": "/sitemap.xml",
      "destination": "/as/sitemap.xml",
      "statusCode": 200
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt",
      "statusCode": 200
    },
    {
      "source": "/ads.xml",
      "destination": "/as/ads.xml",
      "statusCode": 200
    }
  ]
}
