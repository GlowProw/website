    { "src": "/robots.txt", "dest": "/robots.txt", "status": 200 },
    { "src": "/ads.txt", "dest": "/ads.txt", "status": 200 },
    { "src": "/2b62795cf566484f8bc243e7055ae616.txt", "dest": "/2b62795cf566484f8bc243e7055ae616.txt", "status": 200 },
    { "src": "/WW_verify_HnH1pdutwpAkO0XY.txt", "dest": "/WW_verify_HnH1pdutwpAkO0XY.txt", "status": 200 },
    { "src": "/favicon.ico", "dest": "/favicon.ico", "status": 200 },
    { "src": "/favicon.png", "dest": "/favicon.png", "status": 200 },
