{
  "name": "glow-prow-front",
  "description": "This is the glow-prow-front front-end project, presenting the glow-prow-front client for interaction with front-end users.",
  "private": true,
  "version": "0.0.8",
  "type": "module",
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "serve": "vite",
    "type-check": "NODE_OPTIONS='--max-old-space-size=4096' vue-tsc",
    "build:no-check:production": "npm run build-only",
    "build:production": "run-s type-check \"build-only {@}\" --",
    "preview:production": "vite preview",
    "build-only": "vite build --mode production",
    "build:ssg": "npm run build-only:ssg",
    "build-only:ssg": "rm -rf dist .vite-ssg-temp && NODE_OPTIONS='--expose-gc --max-old-space-size=7168' vite-ssg build --mode production",
    "deploy:edgeone:production": "edgeone makers deploy ./dist -n glow-prow-website-cil-build",
    "deploy:edgeone:preview": "edgeone makers deploy ./dist -n glow-prow-website-cil-build -e preview",
    "push:indexnow": "node scripts/push-indexnow.js",
    "postinstall": "node scripts/patch-vite-ssg.js"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.5",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tiptap/extension-dropcursor": "^3.0.7",
    "@tiptap/extension-paragraph": "^3.0.7",
    "@tiptap/extension-placeholder": "^3.0.7",
    "@tiptap/pm": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@tiptap/vue-3": "^3.0.7",
    "@unhead/vue": "^2.0.14",
    "@xenova/transformers": "^2.17.2",
    "@zumer/snapdom": "^2.0.0-dev.4",
    "axios": "^1.10.0",
    "cropperjs": "^1.6.2",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "flexsearch": "^0.8.212",
    "glow-prow-assets": "github:GlowProw/glow-prow-assets",
    "glow-prow-data": "github:GlowProw/glow-prow-data",
    "glow-prow-data-languages": "github:GlowProw/glow-prow-data-languages",
    "less": "^4.4.0",
    "lz-string": "^1.5.0",
    "markdown-it": "^14.1.0",
    "ogl": "^1.0.11",
    "ol": "^10.6.1",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "pixelmatch": "^7.1.0",
    "qrcode": "^1.5.4",
    "smooth-scrollbar": "^8.8.4",
    "uuid": "^11.1.0",
    "vite-plugin-node": "^7.0.0",
    "vite-plugin-sitemap": "^0.8.2",
    "vue": "^3.5.17",
    "vue-i18n": "^9.14.5",
    "vue-json-pretty": "^2.5.0",
    "vue-router": "^4.5.1",
    "vue3-google-adsense": "^1.2.2",
    "vuetify": "^3.8.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/cropperjs": "^1.1.5",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/dom-to-image": "^2.6.7",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.9.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/tsconfig": "^0.7.0",
    "npm-run-all2": "^7.0.2",
    "terser": "^5.44.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vuetify": "^2.1.1",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^2.2.12",
    "jsdom": "25.0.1"
  },
  "overrides": {
    "jsdom": "25.0.1"
  }
}
